# LilyGO T-SIM7080G-S3: ESP32-S3-WROOM-1-N16R8 (16MB Flash / 8MB PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# PSRAM: OPI 8MB (Octal SPI, 80MHz)
# 有効化すると heap_caps_malloc(MALLOC_CAP_SPIRAM) が使用可能になり、
# Opus 疑似スタック(120KB×2)を内部RAMではなく PSRAM に確保できる。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
